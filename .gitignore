# ============================================================
# AquaScope — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so

# Virtual environments
venv/
env/
.venv/
ENV/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# ----- ML Model Artefacts (auto-generated, do not commit) -----
backend/models/*.pkl
backend/models/*.joblib

# ----- Uploaded / Temporary Data Files -----
backend/data/uploaded.csv
backend/data/*.tmp

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.env

# ----- Node.js / Frontend -----
node_modules/
frontend/node_modules/

# Frontend build output
dist/
frontend/dist/
build/
frontend/build/

# npm / pnpm / yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- IDE & Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ----- Windows -----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Linux -----
*~

# ----- Jupyter Notebooks (if used for exploration) -----
.ipynb_checkpoints/
*.ipynb

# ----- Pytest / Coverage -----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ----- Misc -----
*.log
*.bak
*.orig
*.rej
